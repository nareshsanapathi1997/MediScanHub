# Copy to .env for the Next.js runtime. The runtime role cannot bypass RLS.
NODE_ENV=development
APP_URL=http://127.0.0.1:43123
# Local Postgres (npm run db:ensure creates mediscan_hub). One URL is enough; optional PRIVILEGED_DATABASE_URL defaults to DATABASE_URL.
# DATABASE_URL=postgresql://postgres:123456@localhost:5432/mediscan_hub
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/mediscan_hub
# Optional split roles for production-style RLS:
# PRIVILEGED_DATABASE_URL=postgresql://mediscan_admin:...@127.0.0.1:5432/mediscan_hub

# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-session-secret-value
FILE_SIGNING_SECRET=replace-with-a-long-random-file-signing-secret

# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# mock | live
NOTIFICATION_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAMESPACE=

# mock | smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MediScan Hub <no-reply@localhost>"

# mock | msg91
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional shared secret so a cron can call the notification worker.
CRON_SECRET=dev-cron-secret-change-me
BOOTSTRAP_SECRET=dev-cron-secret-change-me

# memory | postgres (shared rate limits across app instances)
RATE_LIMIT_STORE=memory

# Optional interoperability endpoints
PACS_ENDPOINT=
ABDM_HIP_ID=
