// MediScan Hub — multi-tenant diagnostic center & lab schema.
// Clinical rows carry tenantId so Postgres RLS can fail closed.
// Money is stored in paise (integer). Identifiers are UUIDs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ServiceKind {
  LAB
  IMAGING
}

enum ResultType {
  NUMERIC
  QUALITATIVE
  STRUCTURED
}

enum SlotKind {
  CENTER
  HOME
  IMAGING
}

enum VisitType {
  CENTER_VISIT
  HOME_COLLECTION
  WALK_IN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CollectionStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE
  COLLECTED
  CANCELLED
  FAILED
}

enum LabOrderStatus {
  ORDERED
  COLLECTING
  PROCESSING
  RESULTED
  CANCELLED
}

enum SampleStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  RECEIVED
  PROCESSING
  RESULTED
  REJECTED
  RECOLLECTION
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
  ABNORMAL
}

enum ResultStatus {
  DRAFT
  ENTERED
  VERIFIED
}

enum ReportStatus {
  DRAFT
  ENTERED
  VERIFIED
  APPROVED
  RELEASED
  AMENDED
  REJECTED
}

enum ImagingOrderStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
}

enum StudyStatus {
  SCHEDULED
  ACQUIRED
  REPORTED
  CANCELLED
}

enum PacsStatus {
  NOT_INTEGRATED
  QUEUED
  TRANSMITTED
  FAILED
  ACKNOWLEDGED
}

enum IntegrationKind {
  HL7
  FHIR
  ABDM
  PACS
}

enum TpaClaimStatus {
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum InvoiceKind {
  PATIENT
  SUBSCRIPTION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  VOID
  OVERDUE
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Sex {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  phone            String?    @unique
  passwordHash     String
  name             String
  status           UserStatus @default(ACTIVE)
  isSynthetic      Boolean    @default(false)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  sessions              Session[]
  passwordResets        PasswordReset[]
  memberships           TenantMembership[]
  staffAssignments      StaffAssignment[]
  patient               Patient?
  auditLogs             AuditLog[]             @relation("AuditActor")
  notifications         Notification[]
  ticketsOpened         SupportTicket[]        @relation("TicketRequester")
  ticketsAssigned       SupportTicket[]        @relation("TicketAssignee")
  consents              PatientConsent[]
  bookingsCreated       Booking[]              @relation("BookingCreator")
  referredBookings      Booking[]              @relation("BookingReferral")
  statusChanges         BookingStatusHistory[]
  collectionTasks       HomeCollectionTask[]   @relation("Collector")
  sampleEvents          SampleEvent[]
  assignedSamples       Sample[]               @relation("SampleTechnician")
  resultsEntered        LabResult[]            @relation("ResultEnteredBy")
  approvals             ReportApproval[]
  reportVersions        ReportVersion[]
  reportFiles           ReportFile[]
  equipmentSchedules    EquipmentSchedule[]
  verificationsReviewed CenterVerification[]   @relation("VerificationReviewer")
  invitationsSent       Invitation[]           @relation("InvitationSender")

  @@index([status])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  csrfSecret        String
  userAgent         String?
  ipAddress         String?
  activeTenantId    String?   @db.Uuid
  activeBranchId    String?   @db.Uuid
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String
  isSystem    Boolean @default(true)

  permissions RolePermission[]
  memberships TenantMembership[]
  invitations Invitation[]
  assignments StaffAssignment[]
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  legalName     String
  status        TenantStatus @default(PENDING)
  brandColor    String       @default("#0F766E")
  accentColor   String       @default("#155E75")
  logoUrl       String?
  coverImageUrl String?
  galleryUrls   String[]     @default([])
  customDomain  String?      @unique
  email         String
  phone         String
  city          String
  state         String
  address       String
  about         String
  gstin         String?
  isSynthetic   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  memberships         TenantMembership[]
  branches            Branch[]
  verifications       CenterVerification[]
  subscriptions       Subscription[]
  services            DiagnosticService[]
  packages            TestPackage[]
  bookings            Booking[]
  patients            PatientBranchRecord[]
  invoices            Invoice[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  tickets             SupportTicket[]
  invitations         Invitation[]
  equipment           Equipment[]
  integrationMessages IntegrationMessage[]
  tpaClaims           TpaClaim[]
  consents            PatientConsent[]

  @@index([status, city])
  @@index([isSynthetic])
}

model TenantMembership {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String?          @db.Uuid
  tenant     Tenant?          @relation(fields: [tenantId], references: [id])
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String           @db.Uuid
  role       Role             @relation(fields: [roleId], references: [id])
  status     MembershipStatus @default(INVITED)
  invitedBy  String?          @db.Uuid
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([tenantId, userId, roleId])
  @@index([userId])
  @@index([tenantId, status])
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  email      String
  roleId     String    @db.Uuid
  role       Role      @relation(fields: [roleId], references: [id])
  branchId   String?   @db.Uuid
  branch     Branch?   @relation(fields: [branchId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  sentById   String    @db.Uuid
  sentBy     User      @relation("InvitationSender", fields: [sentById], references: [id])
  createdAt  DateTime  @default(now())

  @@index([tenantId, email])
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  code           String
  address        String
  city           String
  state          String
  phone          String
  email          String?
  opensAt        String    @default("07:00")
  closesAt       String    @default("20:00")
  /// Seven entries, Sunday first: {"opensAt":"HH:MM","closesAt":"HH:MM"} or null when closed. Null column = daily opensAt/closesAt.
  weeklyHours    Json?
  /// IST dates (YYYY-MM-DD) when the branch is closed.
  holidays       String[]  @default([])
  homeCollection Boolean   @default(false)
  active         Boolean   @default(true)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  staff       StaffAssignment[]
  services    BranchService[]
  prices      ServicePrice[]
  slots       AvailabilitySlot[]
  bookings    Booking[]
  records     PatientBranchRecord[]
  equipment   Equipment[]
  invitations Invitation[]
  labOrders   LabOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([city])
}

model StaffAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id])
  roleId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, branchId, roleId])
  @@index([tenantId, branchId])
}

model CenterVerification {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  documentType String
  storageKey   String
  fileName     String
  status       VerificationStatus @default(PENDING)
  reviewerId   String?            @db.Uuid
  reviewer     User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id])
  notes        String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([tenantId, status])
}

model SubscriptionPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  tier                String   @unique
  name                String
  description         String
  monthlyPricePaise   Int
  annualPricePaise    Int
  maxBranches         Int?
  maxUsers            Int?
  maxBookingsPerMonth Int?
  trialDays           Int      @default(14)
  features            Json
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  planId             String             @db.Uuid
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices Invoice[]

  @@index([tenantId, status])
  @@index([currentPeriodEnd])
}

model ServiceCategory {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  kind        ServiceKind
  description String
  services    DiagnosticService[]
}

model DiagnosticService {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  categoryId  String          @db.Uuid
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  code        String
  kind        ServiceKind
  description String
  sampleType  String?
  preparation String?
  tatHours    Int
  modality    String?
  published   Boolean         @default(false)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parameters   TestParameter[]
  branchLinks  BranchService[]
  prices       ServicePrice[]
  packageItems PackageItem[]
  bookingItems BookingItem[]
  samples      Sample[]
  studies      ImagingStudy[]

  @@unique([tenantId, slug])
  @@unique([tenantId, code])
  @@index([tenantId, published])
  @@index([kind])
}

model TestParameter {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  serviceId  String            @db.Uuid
  service    DiagnosticService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name       String
  unit       String?
  resultType ResultType
  position   Int               @default(0)

  ranges  ReferenceRange[]
  results LabResult[]

  @@index([serviceId])
}

model ReferenceRange {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  parameterId  String        @db.Uuid
  parameter    TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  sex          Sex?
  ageMinYears  Int?
  ageMaxYears  Int?
  low          Decimal?      @db.Decimal(12, 4)
  high         Decimal?      @db.Decimal(12, 4)
  criticalLow  Decimal?      @db.Decimal(12, 4)
  criticalHigh Decimal?      @db.Decimal(12, 4)
  textValue    String?
  label        String        @default("Adult")

  @@index([parameterId])
}

model TestPackage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  slug        String
  description String
  pricePaise  Int
  published   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items        PackageItem[]
  bookingItems BookingItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, published])
}

model PackageItem {
  id        String            @id @default(uuid()) @db.Uuid
  packageId String            @db.Uuid
  package   TestPackage       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String            @db.Uuid
  service   DiagnosticService @relation(fields: [serviceId], references: [id])

  @@unique([packageId, serviceId])
}

model BranchService {
  tenantId  String            @db.Uuid
  branchId  String            @db.Uuid
  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId String            @db.Uuid
  service   DiagnosticService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  active    Boolean           @default(true)

  @@id([branchId, serviceId])
  @@index([tenantId])
}

model ServicePrice {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  branchId      String            @db.Uuid
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId     String            @db.Uuid
  service       DiagnosticService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pricePaise    Int
  discountPaise Int               @default(0)
  effectiveFrom DateTime          @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime          @default(now())

  @@index([tenantId, branchId, serviceId])
}

model AvailabilitySlot {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  branchId    String     @db.Uuid
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  kind        SlotKind
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  bookedCount Int        @default(0)
  equipmentId String?    @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  bookings Booking[]

  @@index([tenantId, branchId, startsAt])
  @@index([kind, startsAt])
}

model Patient {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime
  sex              Sex
  bloodGroup       String?
  address          String?
  city             String?
  state            String?
  emergencyContact String?
  isSynthetic      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consents          PatientConsent[]
  records           PatientBranchRecord[]
  bookings          Booking[]
  invoices          Invoice[]
  dependents        PatientDependent[]        @relation("GuardianDependents")
  wallet            PatientWallet?
  walletTx          WalletTransaction[]
  insurance         InsurancePolicy[]
  chronicConditions PatientChronicCondition[]
  tpaClaims         TpaClaim[]
}

model PatientConsent {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  tenant    Tenant?   @relation(fields: [tenantId], references: [id])
  patientId String    @db.Uuid
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  purpose   String
  version   String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  ipAddress String?

  bookings Booking[]

  @@index([patientId, purpose])
  @@index([tenantId])
}

model PatientBranchRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id])
  patientId String   @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  mrn       String
  createdAt DateTime @default(now())

  @@unique([tenantId, mrn])
  @@unique([patientId, branchId])
  @@index([tenantId, patientId])
}

model Booking {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @db.Uuid
  tenant                 Tenant            @relation(fields: [tenantId], references: [id])
  branchId               String            @db.Uuid
  branch                 Branch            @relation(fields: [branchId], references: [id])
  patientId              String            @db.Uuid
  patient                Patient           @relation(fields: [patientId], references: [id])
  slotId                 String?           @db.Uuid
  slot                   AvailabilitySlot? @relation(fields: [slotId], references: [id])
  consentId              String?           @db.Uuid
  consent                PatientConsent?   @relation(fields: [consentId], references: [id])
  createdById            String            @db.Uuid
  createdBy              User              @relation("BookingCreator", fields: [createdById], references: [id])
  referralUserId         String?           @db.Uuid
  referral               User?             @relation("BookingReferral", fields: [referralUserId], references: [id])
  publicCode             String            @unique
  visitType              VisitType
  status                 BookingStatus     @default(PENDING)
  scheduledAt            DateTime
  address                String?
  notes                  String?
  dependentId            String?           @db.Uuid
  dependent              PatientDependent? @relation(fields: [dependentId], references: [id])
  prescriptionStorageKey String?
  prescriptionFileName   String?
  totalPaise             Int
  idempotencyKey         String            @unique
  isSynthetic            Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items        BookingItem[]
  history      BookingStatusHistory[]
  collection   HomeCollectionTask?
  labOrder     LabOrder?
  imagingOrder ImagingOrder?
  invoice      Invoice?
  reports      MedicalReport[]

  @@index([tenantId, status, scheduledAt])
  @@index([patientId])
  @@index([branchId, scheduledAt])
  @@index([referralUserId])
}

model BookingItem {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  bookingId   String             @db.Uuid
  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?            @db.Uuid
  service     DiagnosticService? @relation(fields: [serviceId], references: [id])
  packageId   String?            @db.Uuid
  package     TestPackage?       @relation(fields: [packageId], references: [id])
  name        String
  pricePaise  Int
  createdAt   DateTime           @default(now())
  reportFiles ReportFile[]

  @@index([tenantId, bookingId])
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  bookingId  String         @db.Uuid
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?        @db.Uuid
  actor      User?          @relation(fields: [actorId], references: [id])
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([bookingId])
}

model HomeCollectionTask {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  bookingId   String           @unique @db.Uuid
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assigneeId  String?          @db.Uuid
  assignee    User?            @relation("Collector", fields: [assigneeId], references: [id])
  status      CollectionStatus @default(REQUESTED)
  windowStart DateTime
  windowEnd   DateTime
  address     String
  collectedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, status])
}

model LabOrder {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  branchId  String         @db.Uuid
  branch    Branch         @relation(fields: [branchId], references: [id])
  bookingId String         @unique @db.Uuid
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    LabOrderStatus @default(ORDERED)
  orderedAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  samples Sample[]
  reports MedicalReport[]

  @@index([tenantId, status])
}

model Sample {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  labOrderId      String            @db.Uuid
  labOrder        LabOrder          @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  serviceId       String            @db.Uuid
  service         DiagnosticService @relation(fields: [serviceId], references: [id])
  status          SampleStatus      @default(PENDING)
  assigneeId      String?           @db.Uuid
  assignee        User?             @relation("SampleTechnician", fields: [assigneeId], references: [id])
  rejectionReason String?
  collectedAt     DateTime?
  receivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  barcode SampleBarcode?
  events  SampleEvent[]
  results LabResult[]

  @@index([tenantId, status])
  @@index([labOrderId])
  @@index([assigneeId])
}

model SampleBarcode {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  sampleId  String    @unique @db.Uuid
  sample    Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  code      String    @unique
  symbology String    @default("CODE39")
  printedAt DateTime?
  createdAt DateTime  @default(now())
}

model SampleEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  sampleId  String   @db.Uuid
  sample    Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  type      String
  note      String?
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([sampleId])
}

model LabResult {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  sampleId     String        @db.Uuid
  sample       Sample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameterId  String        @db.Uuid
  parameter    TestParameter @relation(fields: [parameterId], references: [id])
  numericValue Decimal?      @db.Decimal(12, 4)
  textValue    String?
  structured   Json?
  flag         ResultFlag?
  status       ResultStatus  @default(DRAFT)
  enteredById  String?       @db.Uuid
  enteredBy    User?         @relation("ResultEnteredBy", fields: [enteredById], references: [id])
  enteredAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([sampleId, parameterId])
  @@index([tenantId])
}

model MedicalReport {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  bookingId      String        @db.Uuid
  booking        Booking       @relation(fields: [bookingId], references: [id])
  labOrderId     String?       @db.Uuid
  labOrder       LabOrder?     @relation(fields: [labOrderId], references: [id])
  imagingOrderId String?       @db.Uuid
  imagingOrder   ImagingOrder? @relation(fields: [imagingOrderId], references: [id])
  status         ReportStatus  @default(DRAFT)
  title          String
  currentVersion Int           @default(0)
  releasedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  approvals ReportApproval[]
  versions  ReportVersion[]
  files     ReportFile[]

  @@index([tenantId, status])
  @@index([bookingId])
}

model ReportApproval {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  reportId   String        @db.Uuid
  report     MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  approverId String        @db.Uuid
  approver   User          @relation(fields: [approverId], references: [id])
  decision   String
  comment    String?
  createdAt  DateTime      @default(now())

  @@index([reportId])
}

model ReportVersion {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  reportId    String        @db.Uuid
  report      MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version     Int
  storageKey  String
  checksum    String
  note        String?
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@unique([reportId, version])
}

enum ReportFileKind {
  LAB_REPORT
  SCAN_IMAGE
  SCAN_REPORT
  OTHER
}

/// A file a center uploads against a report: a scanned blood report, X-ray/CT/MRI image, ultrasound PDF.
/// Bytes live in private storage; patients see a file only after its report is released.
model ReportFile {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  reportId      String         @db.Uuid
  report        MedicalReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  bookingItemId String?        @db.Uuid
  bookingItem   BookingItem?   @relation(fields: [bookingItemId], references: [id])
  kind          ReportFileKind
  fileName      String
  contentType   String
  sizeBytes     Int
  storageKey    String
  checksum      String
  /// Basic study facts read from DICOM headers (modality, study date, series and image counts). Never patient identifiers.
  dicomMeta     Json?
  uploadedById  String         @db.Uuid
  uploadedBy    User           @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now())
  removedAt     DateTime?

  @@index([tenantId, reportId])
}

model Equipment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String   @db.Uuid
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  modality  String
  room      String
  /// Default length of one scan slot on this machine, in minutes.
  slotMinutes Int    @default(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules EquipmentSchedule[]
  blocks    EquipmentBlock[]
  slots     AvailabilitySlot[]
  studies   ImagingStudy[]

  @@index([tenantId, branchId])
}

model EquipmentSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  staffUserId String?   @db.Uuid
  staff       User?     @relation(fields: [staffUserId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())

  @@index([tenantId, equipmentId, startsAt])
}

/// Time when a scan machine cannot be used (service, calibration, breakdown). Slots that overlap a block cannot be booked.
model EquipmentBlock {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  equipmentId String    @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  @@index([tenantId, equipmentId, startsAt])
}

model ImagingOrder {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  bookingId        String             @unique @db.Uuid
  booking          Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  modality         String
  status           ImagingOrderStatus @default(SCHEDULED)
  prepInstructions String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studies ImagingStudy[]
  reports MedicalReport[]

  @@index([tenantId, status])
}

model ImagingStudy {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  imagingOrderId   String            @db.Uuid
  imagingOrder     ImagingOrder      @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  serviceId        String            @db.Uuid
  service          DiagnosticService @relation(fields: [serviceId], references: [id])
  equipmentId      String?           @db.Uuid
  equipment        Equipment?        @relation(fields: [equipmentId], references: [id])
  accession        String            @unique
  status           StudyStatus       @default(SCHEDULED)
  // Reserved for a future DICOM/PACS integration. This product does not speak DICOM.
  studyInstanceUid String?
  pacsStatus       PacsStatus        @default(NOT_INTEGRATED)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, status])
}

model Invoice {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  kind              InvoiceKind
  status            InvoiceStatus    @default(ISSUED)
  number            String           @unique
  bookingId         String?          @unique @db.Uuid
  booking           Booking?         @relation(fields: [bookingId], references: [id])
  patientId         String?          @db.Uuid
  patient           Patient?         @relation(fields: [patientId], references: [id])
  subscriptionId    String?          @db.Uuid
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id])
  subtotalPaise     Int
  taxPaise          Int              @default(0)
  walletRedeemPaise Int              @default(0)
  insurancePolicyId String?          @db.Uuid
  insurancePolicy   InsurancePolicy? @relation(fields: [insurancePolicyId], references: [id])
  tpaReference      String?
  totalPaise        Int
  lines             Json
  issuedAt          DateTime         @default(now())
  dueAt             DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payments  Payment[]
  tpaClaims TpaClaim[]

  @@index([tenantId, status])
  @@index([patientId])
  @@index([insurancePolicyId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  invoiceId         String        @db.Uuid
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])
  provider          String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  idempotencyKey    String        @unique
  currency          String        @default("INR")
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  refunds Refund[]

  @@index([tenantId, status])
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  paymentId        String       @db.Uuid
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amountPaise      Int
  status           RefundStatus @default(REQUESTED)
  reason           String
  providerRefundId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tenantId])
}

model Notification {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String?             @db.Uuid
  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  userId        String?             @db.Uuid
  user          User?               @relation(fields: [userId], references: [id])
  channel       NotificationChannel
  templateKey   String
  toAddress     String
  payload       Json
  status        NotificationStatus  @default(QUEUED)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  readAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  deliveries NotificationDeliveryAttempt[]

  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

model NotificationDeliveryAttempt {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempt        Int
  status         String
  error          String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
}

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  key         String   @unique
  scope       String
  requestHash String
  response    Json
  statusCode  Int
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model SupportTicket {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String?        @db.Uuid
  tenant      Tenant?        @relation(fields: [tenantId], references: [id])
  requesterId String         @db.Uuid
  requester   User           @relation("TicketRequester", fields: [requesterId], references: [id])
  assigneeId  String?        @db.Uuid
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  subject     String
  body        String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([status, priority])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model PatientDependent {
  id                String    @id @default(uuid()) @db.Uuid
  guardianPatientId String    @db.Uuid
  guardian          Patient   @relation("GuardianDependents", fields: [guardianPatientId], references: [id], onDelete: Cascade)
  name              String
  dateOfBirth       DateTime
  sex               Sex
  relation          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]

  @@index([guardianPatientId])
}

model PatientChronicCondition {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition String
  since     DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([patientId])
}

model PatientWallet {
  patientId    String   @id @db.Uuid
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  balancePaise Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amountPaise Int
  reason      String
  bookingId   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([patientId, createdAt])
}

model InsurancePolicy {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @db.Uuid
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider     String
  policyNumber String
  tpaName      String?
  validUntil   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoices Invoice[]
  claims   TpaClaim[]

  @@index([patientId])
}

model TpaClaim {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  patientId         String          @db.Uuid
  patient           Patient         @relation(fields: [patientId], references: [id])
  invoiceId         String          @db.Uuid
  invoice           Invoice         @relation(fields: [invoiceId], references: [id])
  insurancePolicyId String          @db.Uuid
  insurancePolicy   InsurancePolicy @relation(fields: [insurancePolicyId], references: [id])
  status            TpaClaimStatus  @default(SUBMITTED)
  claimedPaise      Int
  approvedPaise     Int?
  paidPaise         Int?
  externalReference String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([patientId])
  @@index([invoiceId])
}

model RateLimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  bucketKey String
  hitAt     DateTime @default(now())

  @@index([bucketKey, hitAt])
}

model GeoCountry {
  id        Int        @id
  name      String
  iso2      String     @unique @db.Char(2)
  iso3      String     @unique @db.Char(3)
  phonecode String?
  capital   String?
  currency  String?
  states    GeoState[]
  cities    GeoCity[]
}

model GeoState {
  id          Int        @id
  name        String
  countryId   Int        @map("country_id")
  country     GeoCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)
  countryCode String     @map("country_code") @db.Char(2)
  stateCode   String?    @map("state_code")
  cities      GeoCity[]

  @@index([countryId])
  @@index([countryCode])
}

model GeoCity {
  id          Int        @id
  name        String
  stateId     Int        @map("state_id")
  state       GeoState   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  countryId   Int        @map("country_id")
  country     GeoCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)
  countryCode String     @map("country_code") @db.Char(2)

  @@index([stateId])
  @@index([countryId])
  @@index([name])
}

model IntegrationMessage {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String?         @db.Uuid
  tenant      Tenant?         @relation(fields: [tenantId], references: [id])
  kind        IntegrationKind
  direction   String
  referenceId String?
  payload     Json
  status      String
  createdAt   DateTime        @default(now())

  @@index([tenantId, kind, createdAt])
}
