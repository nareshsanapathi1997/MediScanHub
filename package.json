{
  "name": "mediscan-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 43123 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "npx --yes rimraf .next test-results playwright-report blob-report coverage storage storage-test tsconfig.tsbuildinfo",
    "geo:fetch": "tsx scripts/fetch-geo.ts",
    "geo:import": "tsx scripts/import-geo.ts",
    "db:ensure": "psql \"postgresql://postgres:123456@localhost:5432/postgres\" -f scripts/ensure-database.sql && psql \"postgresql://postgres:123456@localhost:5432/mediscan_hub\" -f scripts/bootstrap-local.sql && psql \"postgresql://postgres:123456@localhost:5432/mediscan_test\" -f scripts/bootstrap-local.sql",
    "db:bootstrap": "psql \"postgresql://mediscan:mediscan_dev@127.0.0.1:5432/mediscan\" -f scripts/bootstrap-local.sql",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:ensure && npm run db:migrate && npm run db:seed",
    "cron:worker": "tsx scripts/cron-worker.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dicom-parser": "^1.8.21",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.56.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "fflate": "^0.8.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
