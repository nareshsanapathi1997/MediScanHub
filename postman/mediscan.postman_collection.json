{
  "info": {
    "name": "MediScan Hub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Session cookie plus x-csrf-token for mutations. Login and the webhook are exempt."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:43123"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "sampleId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "fileId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient.asha@mediscan.test\",\n  \"password\": \"Synthetic#2026\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/session"
      }
    },
    {
      "name": "Search tests",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog/search?city=Hyderabad&q=CBC"
      }
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-booking-1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"branchId\": \"40000000-0000-4000-8000-000000000001\",\n  \"slotId\": \"replace-with-a-slot-id\",\n  \"serviceIds\": [\"80000000-0000-4000-8000-000000000003\"],\n  \"packageIds\": [],\n  \"visitType\": \"CENTER_VISIT\",\n  \"idempotencyKey\": \"postman-booking-1\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/bookings"
      }
    },
    {
      "name": "Payment webhook",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-mediscan-signature",
            "value": "hmac-sha256-of-raw-body"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_postman_1\",\n  \"event\": \"payment.captured\",\n  \"payload\": { \"payment\": { \"entity\": { \"id\": \"pay_postman_1\", \"order_id\": \"order_id\", \"amount\": 35000 } } }\n}"
        },
        "url": "{{baseUrl}}/api/v1/payments/webhook"
      }
    },
    {
      "name": "Assign sample technician",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assigneeId\": \"20000000-0000-4000-8000-000000000006\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/samples/{{sampleId}}/assign"
      }
    },
    {
      "name": "Run notification worker",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-cron-secret",
            "value": "dev-cron-secret-change-me"
          }
        ],
        "url": "{{baseUrl}}/api/v1/notifications/process"
      }
    },
    {
      "name": "Scan slots (CT)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/slots?branchId=40000000-0000-4000-8000-000000000001&day=2026-10-20&kind=IMAGING&modality=CT"
      }
    },
    {
      "name": "Upload DICOM study",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          },
          {
            "key": "content-type",
            "value": "application/octet-stream"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": ""
          }
        },
        "url": "{{baseUrl}}/api/v1/uploads/dicom?reportId={{reportId}}&name=study.zip",
        "description": "Radiology staff session. Body is the raw .dcm file or a .zip of the study, up to 500 MB."
      }
    },
    {
      "name": "Remove report file",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-csrf-token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/report-files/{{fileId}}"
      }
    }
  ]
}
